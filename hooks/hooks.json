{
  "description": "Keeps Claude from pushing without the ravenwatch git pre-push hook, and from bypassing it or editing its verdict state.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_push.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
